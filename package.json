{
  "name": "orogami",
  "version": "0.1.0",
  "description": "日本語(CJK)のタイトルを自然な位置で折り返す。@vercel/og や Satori に1行で寄生する wrap ユーティリティ＋フォント自動サブセットOGP生成。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./og": {
      "types": "./dist/og.d.ts",
      "import": "./dist/og.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "pretest": "npm run build",
    "test": "node --test",
    "prepublishOnly": "npm run build",
    "demo": "node examples/demo.ts",
    "render": "node examples/render.ts"
  },
  "keywords": [
    "ogp",
    "budoux",
    "cjk",
    "japanese",
    "line-break",
    "word-break",
    "satori",
    "vercel-og",
    "font-subset",
    "禁則",
    "分かち書き"
  ],
  "license": "MIT",
  "author": "hyuga611",
  "homepage": "https://github.com/hyuga611/orogami#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyuga611/orogami.git"
  },
  "bugs": {
    "url": "https://github.com/hyuga611/orogami/issues"
  },
  "dependencies": {
    "budoux": "^0.7.0"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "*",
    "satori": "*",
    "subset-font": "*"
  },
  "peerDependenciesMeta": {
    "satori": {
      "optional": true
    },
    "@resvg/resvg-js": {
      "optional": true
    },
    "subset-font": {
      "optional": true
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.1.1",
    "satori": "^0.29.0",
    "subset-font": "^2.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
